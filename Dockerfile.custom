# Stage 1: Build do frontend Svelte 5 PWA
FROM node:22-alpine AS frontend-builder
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci || npm install
COPY frontend/ ./
RUN npm run build

# Stage 2: Build do executável estático em Go
FROM golang:alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=frontend-builder /build/internal/spa/dist /src/internal/spa/dist
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /calibre-web-go ./cmd/server/main.go

# Stage 3: Runtime minimalista
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata wget p7zip \
    && wget -q -O /usr/local/bin/kepubify https://github.com/pgaskin/kepubify/releases/latest/download/kepubify-linux-64bit \
    && chmod +x /usr/local/bin/kepubify \
    && apk del wget

WORKDIR /app

COPY --from=builder /calibre-web-go /app/calibre-web-go
COPY cps/static /app/cps/static
COPY empty_library /app/empty_library

ENV PORT=8083 \
    LIBRARY_PATH=/library \
    INGEST_PATH=/ingest \
    STATIC_PATH=/app/cps/static \
    GOMEMLIMIT=35MiB \
    GOGC=60

VOLUME ["/library", "/ingest"]
EXPOSE 8083

ENTRYPOINT ["/app/calibre-web-go"]
